<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ========================================== -->
    <!--  VONIC TYPOGRAPHY SYSTEM (Be Vietnam Pro)  -->
    <!-- ========================================== -->
    <style name="TextAppearance.Vonic.Head1" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textSize">@dimen/font_head_1</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/neutral_text</item>
        <item name="android:letterSpacing">0.0</item>
    </style>

    <style name="TextAppearance.Vonic.Head2" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textSize">@dimen/font_head_2</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/neutral_text</item>
        <item name="android:letterSpacing">0.0</item>
    </style>

    <style name="TextAppearance.Vonic.Head3" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">@dimen/font_head_3</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/neutral_text</item>
        <item name="android:letterSpacing">0.0</item>
    </style>

    <style name="TextAppearance.Vonic.Head4" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">@dimen/font_head_4</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/neutral_text</item>
        <item name="android:letterSpacing">0.0</item>
    </style>

    <style name="TextAppearance.Vonic.Body1" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">@dimen/font_body_1</item>
        <item name="android:textColor">@color/neutral_text</item>
        <item name="android:lineSpacingMultiplier">1.3</item>
    </style>

    <style name="TextAppearance.Vonic.Body2" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">@dimen/font_body_2</item>
        <item name="android:textColor">@color/neutral_text</item>
        <item name="android:lineSpacingMultiplier">1.3</item>
    </style>

    <style name="TextAppearance.Vonic.Body3" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">@dimen/font_body_3</item>
        <item name="android:textColor">@color/neutral_muted</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
    </style>

    <style name="TextAppearance.Vonic.Body4" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">@dimen/font_body_4</item>
        <item name="android:textColor">@color/neutral_muted</item>
    </style>

    <style name="TextAppearance.Vonic.Body5" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">@dimen/font_body_5</item>
        <item name="android:textColor">@color/neutral_muted</item>
    </style>

    <!-- ========================================== -->
    <!--  VONIC BUTTON PACKAGE                      -->
    <!-- ========================================== -->
    <style name="Widget.Vonic" parent="android:Widget" />
    <style name="Widget.Vonic.Button" parent="Widget.Material3.Button" />

    <style name="Widget.Vonic.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="backgroundTint">@null</item>
        <item name="android:textColor">@color/neutral_white</item>
        <item name="android:textSize">@dimen/font_body_2</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingTop">@dimen/spacing_md</item>
        <item name="android:paddingBottom">@dimen/spacing_md</item>
        <item name="android:paddingStart">@dimen/spacing_xl</item>
        <item name="android:paddingEnd">@dimen/spacing_xl</item>
    </style>

    <style name="Widget.Vonic.Button.Secondary" parent="Widget.Material3.Button">
        <item name="android:background">@drawable/bg_button_secondary</item>
        <item name="backgroundTint">@null</item>
        <item name="android:textColor">@color/neutral_white</item>
        <item name="android:textSize">@dimen/font_body_2</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingTop">@dimen/spacing_md</item>
        <item name="android:paddingBottom">@dimen/spacing_md</item>
        <item name="android:paddingStart">@dimen/spacing_xl</item>
        <item name="android:paddingEnd">@dimen/spacing_xl</item>
    </style>

    <style name="Widget.Vonic.Button.Outline" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:background">@drawable/bg_button_outline</item>
        <item name="backgroundTint">@null</item>
        <item name="android:textColor">@color/primary_main</item>
        <item name="android:textSize">@dimen/font_body_2</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingTop">@dimen/spacing_md</item>
        <item name="android:paddingBottom">@dimen/spacing_md</item>
        <item name="android:paddingStart">@dimen/spacing_xl</item>
        <item name="android:paddingEnd">@dimen/spacing_xl</item>
    </style>

    <!-- Card Style -->
    <style name="Widget.Vonic.Card" parent="Widget.Vonic">
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:elevation">@dimen/card_elevation</item>
        <item name="android:padding">@dimen/spacing_lg</item>
    </style>
</resources>
